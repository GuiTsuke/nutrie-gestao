<Window x:Class="NutrieGestao.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:h="clr-namespace:NutrieGestao.Helpers"
        xmlns:m="clr-namespace:NutrieGestao.Models;assembly=NutrieGestao.Core"
        Title="Nutriê Gestão" Width="1280" Height="800" MinWidth="1000" MinHeight="650"
        WindowStartupLocation="CenterScreen" Background="#F5F7F3">
    <Window.Resources>
        <h:BoolToVisibilityConverter x:Key="Visible"/>
        <h:InverseBoolToVisibilityConverter x:Key="Hidden"/>
        <h:PageVisibilityConverter x:Key="Page"/>
        <h:StatusTextConverter x:Key="Status"/>
        <Style TargetType="TextBox"><Setter Property="Padding" Value="9,6"/><Setter Property="Margin" Value="0,3,0,9"/></Style>
        <Style TargetType="Button"><Setter Property="Padding" Value="13,8"/><Setter Property="Margin" Value="0,3"/><Setter Property="Background" Value="#3E7652"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/></Style>
        <Style x:Key="Nav" TargetType="Button"><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="18,11"/><Setter Property="Margin" Value="8,2"/></Style>
        <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="20"/><Setter Property="Margin" Value="0,0,14,14"/></Style>
        <Style TargetType="DataGrid"><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="RowHeight" Value="36"/><Setter Property="GridLinesVisibility" Value="None"/></Style>
        <Style TargetType="ComboBox"><Setter Property="Padding" Value="7"/><Setter Property="Margin" Value="0,3,0,9"/></Style>
        <Style TargetType="DatePicker"><Setter Property="Margin" Value="0,3,0,9"/></Style>
    </Window.Resources>
    <Grid>
        <Grid Visibility="{Binding EmConfiguracaoInicial, Converter={StaticResource Visible}}" Background="#EAF2E8">
            <Border Width="700" Padding="40" CornerRadius="18" Background="White" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Nutriê Gestão" FontSize="28" FontWeight="Bold" Foreground="#3E7652"/>
                    <TextBlock Text="Configuração inicial" FontSize="22" Margin="0,18,0,4"/>
                    <TextBlock Text="Informe os dados da sua empresa. Você poderá alterá-los a qualquer momento." Foreground="#637169" Margin="0,0,0,16"/>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,12,0"><TextBlock Text="Nome da empresa *"/><TextBox Text="{Binding Empresa.Nome, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Responsável *"/><TextBox Text="{Binding Empresa.Responsavel, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Telefone"/><TextBox Text="{Binding Empresa.Telefone}"/><TextBlock Text="WhatsApp"/><TextBox Text="{Binding Empresa.WhatsApp}"/></StackPanel>
                        <StackPanel Grid.Column="1"><TextBlock Text="Instagram"/><TextBox Text="{Binding Empresa.Instagram}"/><TextBlock Text="Endereço"/><TextBox Text="{Binding Empresa.Endereco}"/><TextBlock Text="Cidade"/><TextBox Text="{Binding Empresa.Cidade}"/><TextBlock Text="Estado"/><TextBox Text="{Binding Empresa.Estado}"/></StackPanel>
                    </Grid>
                    <Button Content="Começar a usar" Command="{Binding SalvarEmpresaCommand}" HorizontalAlignment="Right" Padding="24,10"/>
                </StackPanel>
            </Border>
        </Grid>
        <Grid Visibility="{Binding EmConfiguracaoInicial, Converter={StaticResource Hidden}}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Border Background="#254B35"><DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="20,28"><TextBlock Text="Nutriê" FontSize="27" FontWeight="Bold" Foreground="White"/><TextBlock Text="GESTÃO" Foreground="#B5D4B9" Margin="2,0,0,28"/>
                    <Button Style="{StaticResource Nav}" Content="⌂   Dashboard" Command="{Binding NavegarCommand}" CommandParameter="{x:Static m:Pagina.Dashboard}"/>
                    <Button Style="{StaticResource Nav}" Content="▣   Pedidos" Command="{Binding NavegarCommand}" CommandParameter="{x:Static m:Pagina.Pedidos}"/>
                    <Button Style="{StaticResource Nav}" Content="♙   Clientes" Command="{Binding NavegarCommand}" CommandParameter="{x:Static m:Pagina.Clientes}"/>
                    <Button Style="{StaticResource Nav}" Content="◈   Marmitas" Command="{Binding NavegarCommand}" CommandParameter="{x:Static m:Pagina.Marmitas}"/>
                    <Button Style="{StaticResource Nav}" Content="⚙   Configurações" Command="{Binding NavegarCommand}" CommandParameter="{x:Static m:Pagina.Configuracoes}"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="20"><TextBlock Text="{Binding Empresa.Nome}" Foreground="White" TextWrapping="Wrap"/><TextBlock Text="Versão 0.1 • MVP" Foreground="#B5D4B9" FontSize="11" Margin="0,5,0,0"/></StackPanel>
            </DockPanel></Border>
            <Grid Grid.Column="1" Margin="32,25"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBlock Text="{Binding Mensagem}" Foreground="#3E7652" HorizontalAlignment="Right"/>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><Grid>
                    <StackPanel Visibility="{Binding PaginaAtual, Converter={StaticResource Page}, ConverterParameter=Dashboard}">
                        <TextBlock Text="Dashboard" FontSize="30" FontWeight="SemiBold"/>
                        <TextBlock Text="Veja como está o seu negócio hoje." Margin="0,5,0,22" Foreground="#66736B"/>
                        <UniformGrid Columns="4">
                            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="FATURAMENTO TOTAL" FontSize="11" Foreground="#68746D"/><TextBlock Text="{Binding FaturamentoTotal, StringFormat={}{0:C}}" FontSize="23" FontWeight="Bold" Foreground="#2F6B47"/></StackPanel></Border>
                            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="EM ANDAMENTO" FontSize="11" Foreground="#68746D"/><TextBlock Text="{Binding PedidosEmAndamento}" FontSize="23" FontWeight="Bold"/></StackPanel></Border>
                            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="CONCLUÍDOS" FontSize="11" Foreground="#68746D"/><TextBlock Text="{Binding PedidosConcluidos}" FontSize="23" FontWeight="Bold"/></StackPanel></Border>
                            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="CLIENTES" FontSize="11" Foreground="#68746D"/><TextBlock Text="{Binding Clientes.Count}" FontSize="23" FontWeight="Bold"/></StackPanel></Border>
                        </UniformGrid>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Pedidos recentes" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/><DataGrid ItemsSource="{Binding PedidosRecentes}"><DataGrid.Columns><DataGridTextColumn Header="PEDIDO" Binding="{Binding Numero}"/><DataGridTextColumn Header="CLIENTE" Binding="{Binding NomeCliente}" Width="*"/><DataGridTextColumn Header="ENTREGA" Binding="{Binding DataEntrega, StringFormat={}{0:dd/MM/yyyy}}"/><DataGridTextColumn Header="VALOR" Binding="{Binding ValorTotal, StringFormat={}{0:C}}"/></DataGrid.Columns></DataGrid></StackPanel></Border>
                            <Border Grid.Column="1" Style="{StaticResource Card}"><StackPanel><TextBlock Text="Faturamento do mês" Foreground="#68746D"/><TextBlock Text="{Binding FaturamentoMes, StringFormat={}{0:C}}" FontSize="25" FontWeight="Bold" Foreground="#2F6B47"/><TextBlock Text="Resumo por status" FontSize="17" FontWeight="SemiBold" Margin="0,18,0,8"/><ItemsControl ItemsSource="{Binding Statuses}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource Status}}" Margin="0,5"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
                        </Grid>
                    </StackPanel>
                    <Grid Visibility="{Binding PaginaAtual, Converter={StaticResource Page}, ConverterParameter=Clientes}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="330"/></Grid.ColumnDefinitions>
                        <StackPanel><DockPanel><Button Content="+ Novo cliente" Command="{Binding NovoClienteCommand}" DockPanel.Dock="Right"/><TextBox Width="270" Text="{Binding BuscaCliente, UpdateSourceTrigger=PropertyChanged}" ToolTip="Pesquisar por nome ou telefone"/></DockPanel><TextBlock Text="Clientes" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="Selecione um cliente para editar." Foreground="#66736B" Margin="0,5,0,14"/><DataGrid ItemsSource="{Binding ClientesView}" SelectedItem="{Binding ClienteSelecionado, Mode=TwoWay}"><DataGrid.Columns><DataGridTextColumn Header="NOME" Binding="{Binding Nome}" Width="*"/><DataGridTextColumn Header="TELEFONE" Binding="{Binding Telefone}"/><DataGridTextColumn Header="WHATSAPP" Binding="{Binding WhatsApp}"/><DataGridTextColumn Header="CIDADE" Binding="{Binding Cidade}"/></DataGrid.Columns></DataGrid></StackPanel>
                        <Border Grid.Column="1" Style="{StaticResource Card}" Margin="22,38,0,0"><StackPanel DataContext="{Binding ClienteSelecionado}"><TextBlock Text="Dados do cliente" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Nome *"/><TextBox Text="{Binding Nome}"/><TextBlock Text="Telefone"/><TextBox Text="{Binding Telefone}"/><TextBlock Text="WhatsApp"/><TextBox Text="{Binding WhatsApp}"/><TextBlock Text="Endereço"/><TextBox Text="{Binding Endereco}"/><TextBlock Text="Número"/><TextBox Text="{Binding Numero}"/><TextBlock Text="Bairro / cidade"/><TextBox Text="{Binding Bairro}"/><TextBox Text="{Binding Cidade}"/><Button Content="Salvar cliente" Command="{Binding DataContext.SalvarClienteCommand, RelativeSource={RelativeSource AncestorType=Window}}"/><Button Content="Excluir" Background="#A84444" Command="{Binding DataContext.ExcluirClienteCommand, RelativeSource={RelativeSource AncestorType=Window}}"/></StackPanel></Border>
                    </Grid>
                    <Grid Visibility="{Binding PaginaAtual, Converter={StaticResource Page}, ConverterParameter=Marmitas}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="330"/></Grid.ColumnDefinitions>
                        <StackPanel><DockPanel><Button Content="+ Nova marmita" Command="{Binding NovaMarmitaCommand}" DockPanel.Dock="Right"/><TextBox Width="270" Text="{Binding BuscaMarmita, UpdateSourceTrigger=PropertyChanged}" ToolTip="Pesquisar por nome"/></DockPanel><TextBlock Text="Marmitas" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="Produtos ativos ficam disponíveis para novos pedidos." Foreground="#66736B" Margin="0,5,0,14"/><DataGrid ItemsSource="{Binding MarmitasView}" SelectedItem="{Binding MarmitaSelecionada, Mode=TwoWay}"><DataGrid.Columns><DataGridTextColumn Header="NOME" Binding="{Binding Nome}" Width="*"/><DataGridTextColumn Header="CATEGORIA" Binding="{Binding Categoria}"/><DataGridTextColumn Header="TAMANHO" Binding="{Binding Tamanho}"/><DataGridTextColumn Header="PREÇO" Binding="{Binding Preco, StringFormat={}{0:C}}"/><DataGridCheckBoxColumn Header="ATIVA" Binding="{Binding Ativo}"/></DataGrid.Columns></DataGrid></StackPanel>
                        <Border Grid.Column="1" Style="{StaticResource Card}" Margin="22,38,0,0"><StackPanel DataContext="{Binding MarmitaSelecionada}"><TextBlock Text="Dados da marmita" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Nome *"/><TextBox Text="{Binding Nome}"/><TextBlock Text="Descrição"/><TextBox Text="{Binding Descricao}"/><TextBlock Text="Categoria"/><TextBox Text="{Binding Categoria}"/><TextBlock Text="Tamanho"/><ComboBox ItemsSource="{Binding DataContext.TamanhosDisponiveis, RelativeSource={RelativeSource AncestorType=Window}}" SelectedItem="{Binding Tamanho}"/><TextBlock Text="Preço"/><TextBox Text="{Binding Preco}"/><CheckBox Content="Marmita ativa" IsChecked="{Binding Ativo}" Margin="0,4,0,8"/><Button Content="Salvar marmita" Command="{Binding DataContext.SalvarMarmitaCommand, RelativeSource={RelativeSource AncestorType=Window}}"/><Button Content="Excluir" Background="#A84444" Command="{Binding DataContext.ExcluirMarmitaCommand, RelativeSource={RelativeSource AncestorType=Window}}"/></StackPanel></Border>
                    </Grid>
                    <Grid Visibility="{Binding PaginaAtual, Converter={StaticResource Page}, ConverterParameter=Pedidos}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <DockPanel><Button Content="+ Novo pedido" Command="{Binding NovoPedidoCommand}" DockPanel.Dock="Right"/><TextBox Width="270" Text="{Binding BuscaPedido, UpdateSourceTrigger=PropertyChanged}" ToolTip="Buscar por pedido ou cliente"/><TextBlock Text="Pedidos" FontSize="30" FontWeight="SemiBold" Margin="0,5"/></DockPanel>
                        <Grid Grid.Row="1" Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="390"/></Grid.ColumnDefinitions>
                            <DataGrid ItemsSource="{Binding PedidosView}" SelectedItem="{Binding PedidoSelecionado, Mode=TwoWay}"><DataGrid.Columns><DataGridTextColumn Header="PEDIDO" Binding="{Binding Numero}"/><DataGridTextColumn Header="CLIENTE" Binding="{Binding NomeCliente}" Width="*"/><DataGridTextColumn Header="ENTREGA" Binding="{Binding DataEntrega, StringFormat={}{0:dd/MM}}"/><DataGridTextColumn Header="TOTAL" Binding="{Binding ValorTotal, StringFormat={}{0:C}}"/><DataGridTextColumn Header="PAGO" Binding="{Binding ValorPago, StringFormat={}{0:C}}"/><DataGridTextColumn Header="STATUS" Binding="{Binding Status, Converter={StaticResource Status}}"/></DataGrid.Columns></DataGrid>
                            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="22,0,0,0"><ScrollViewer><StackPanel><TextBlock Text="Novo pedido" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Cliente *"/><ComboBox ItemsSource="{Binding Clientes}" SelectedItem="{Binding ClienteDoPedido}" DisplayMemberPath="Nome"/><TextBlock Text="Entrega"/><DatePicker SelectedDate="{Binding EntregaDoPedido}"/><Separator Margin="0,4,0,8"/><TextBlock Text="Adicionar marmita"/><ComboBox ItemsSource="{Binding MarmitasAtivas}" SelectedItem="{Binding MarmitaDoItem}" DisplayMemberPath="Nome"/><TextBlock Text="Quantidade"/><TextBox Text="{Binding QuantidadeItem}"/><Button Content="Adicionar item" Command="{Binding AdicionarItemCommand}"/><ItemsControl ItemsSource="{Binding ItensDoPedido}"><ItemsControl.ItemTemplate><DataTemplate><DockPanel Margin="0,6"><Button Content="×" DockPanel.Dock="Right" Background="#A84444" Padding="8,2" Command="{Binding DataContext.RemoverItemCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/><TextBlock Text="{Binding Marmita.Nome}"/><TextBlock Text="{Binding Subtotal, StringFormat={}{0:C}}" DockPanel.Dock="Bottom" Foreground="#3E7652"/></DockPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="{Binding TotalDoPedido, StringFormat=Total: {0:C}}" FontSize="18" FontWeight="Bold" Margin="0,8"/><TextBlock Text="Forma de pagamento"/><ComboBox ItemsSource="{Binding FormasPagamento}" SelectedItem="{Binding FormaPagamento}"/><TextBlock Text="Valor pago"/><TextBox Text="{Binding ValorPago}"/><TextBlock Text="{Binding PendenteDoPedido, StringFormat=Pendente: {0:C}}" Foreground="#A06828"/><TextBlock Text="Observações"/><TextBox Text="{Binding ObservacoesPedido}" Height="45" TextWrapping="Wrap"/><Button Content="Salvar pedido" Command="{Binding SalvarPedidoCommand}"/></StackPanel></ScrollViewer></Border>
                        </Grid>
                    </Grid>
                    <StackPanel Visibility="{Binding PaginaAtual, Converter={StaticResource Page}, ConverterParameter=Configuracoes}"><TextBlock Text="Configurações" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="Dados da empresa" FontSize="20" Margin="0,20,0,8"/><Border Style="{StaticResource Card}" Width="620" HorizontalAlignment="Left"><Grid DataContext="{Binding Empresa}"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,12,0"><TextBlock Text="Nome da empresa *"/><TextBox Text="{Binding Nome}"/><TextBlock Text="Responsável *"/><TextBox Text="{Binding Responsavel}"/><TextBlock Text="Telefone"/><TextBox Text="{Binding Telefone}"/><TextBlock Text="WhatsApp"/><TextBox Text="{Binding WhatsApp}"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Instagram"/><TextBox Text="{Binding Instagram}"/><TextBlock Text="Endereço"/><TextBox Text="{Binding Endereco}"/><TextBlock Text="Cidade"/><TextBox Text="{Binding Cidade}"/><TextBlock Text="Estado"/><TextBox Text="{Binding Estado}"/><Button Content="Salvar alterações" Command="{Binding DataContext.SalvarEmpresaCommand, RelativeSource={RelativeSource AncestorType=Window}}"/></StackPanel></Grid></Border></StackPanel>
                </Grid></ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>
